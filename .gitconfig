[user]
	name = Eric DeMoney
	email = edemoney@ciena.com

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)

[merge]
    conflictstyle = diff3
	tool = meld

[diff]
    colorMoved = default

[rebase]
	autoStash = true

[pull]
	rebase = true

[mergetool "meld"]
	path = /opt/homebrew/bin/meld

[mergetool]
	prompt = false
	keepBackup = false
